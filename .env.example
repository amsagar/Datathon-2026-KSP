# KSP Agent — environment template.
#
# Copy to `.env.prod` (git-ignored) and fill in real values. NEVER commit a filled-in copy.
# Secrets marked (SECRET) must be generated per-environment and rotated if ever exposed.
#
#   cp .env.example .env.prod

# ---------- Spring ----------
SPRING_PROFILES_ACTIVE=prod
SPRING_SQL_INIT_MODE=always
SPRING_AI_CHAT_MEMORY_REPOSITORY_JDBC_INITIALIZE_SCHEMA=always

# ---------- Application database (agent data: sessions, users, audit, usage) ----------
DB_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=                      # (SECRET)

# ---------- Crime database (read-only Karnataka Police FIR data) ----------
# Seeded separately and manually: psql "$CRIME_DB_URL" -f scripts/fir-seed.sql
CRIME_DB_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
CRIME_DB_USERNAME=
CRIME_DB_PASSWORD=                # (SECRET)

# ---------- Crypto / auth ----------
# AGENT_ENCRYPTION_KEY encrypts stored tool-auth credentials at rest.
# WARNING: rotating it invalidates every stored tool-auth secret — they must be re-entered.
# Generate: openssl rand -hex 32
AGENT_ENCRYPTION_KEY=             # (SECRET)
# Generate: openssl rand -base64 48
JWT_SECRET=                       # (SECRET)
# Shared secret guarding /api/v1/internal/cron/* (Catalyst Cron calls these).
CRON_SECRET=                      # (SECRET)

# ---------- LLM (Zoho Catalyst QuickML, OpenAI-compatible) ----------
LLM_BASE_URL=https://api.catalyst.zoho.in
LLM_COMPLETIONS_PATH=/quickml/v1/project/<project-id>/glm/chat
LLM_CATALYST_ORG=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_CLIENT_ID=
LLM_CLIENT_SECRET=                # (SECRET)
LLM_REFRESH_TOKEN=                # (SECRET)
LLM_ACCOUNTS_BASE_URL=https://accounts.zoho.in

# ---------- RAG (optional; Catalyst QuickML RAG) ----------
RAG_BASE_URL=
RAG_COMPLETIONS_PATH=
RAG_CATALYST_ORG=

# ---------- Blob storage (Catalyst Stratus) ----------
STRATUS_BUCKET_URL=
STRATUS_CATALYST_ORG=

# ---------- Agent tuning (safe defaults shown; override only if you mean to) ----------
SKILL_UPDATE_ENABLED=true
SKILL_UPDATE_TIMEOUT_MINUTES=10
TOOL_SEARCH_THRESHOLD=15
TOOL_SEARCH_MAX_RESULTS=3

# Conversation memory. These control multi-turn follow-up quality: the model sees
# `recent-window` verbatim messages, and older turns are folded into a summary once the
# transcript exceeds `summary-threshold`. Low values (e.g. 2/1) make the assistant
# effectively stateless across turns — use the defaults below unless debugging.
MEMORY_SUMMARY_THRESHOLD=40
MEMORY_RECENT_WINDOW=20
MEMORY_SEMANTIC_TOP_K=6
MEMORY_SEMANTIC_MIN_CONFIDENCE=0.3
MEMORY_SEMANTIC_EXTRACT_MIN_CONFIDENCE=0.3

# ---------- Temporary chats ----------
CHAT_TEMPORARY_RETENTION_DAYS=30
CHAT_TEMPORARY_PURGE_CRON=0 30 3 * * *

# ---------- CORS ----------
# Comma-separated origins allowed to call the API (the deployed UI URL).
CORS_ALLOWED_ORIGINS=
