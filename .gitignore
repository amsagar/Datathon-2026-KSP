# Compiled class file
*.class
.idea/
# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
client/.env.development
service/src/main/resources/application-local.yml
client/node_modules

# Build output — never commit. target/classes/ mirrors src/main/resources, which
# includes the git-ignored application-local.yml; committing target/ leaks it anyway.
target/
service/target/

# Environment files with secrets — never commit
.env
.env.*
!.env.example
.claude/
